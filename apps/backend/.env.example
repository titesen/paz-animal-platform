# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# DATABASE
# ==========================================
# Runtime connection (app_paz_animal user - DML only)
DATABASE_URL=postgresql://app_paz_animal:dev_password@localhost:5432/paz_animal_local

# Migration connection (db_owner user - DDL operations)
# Used by drizzle-kit for schema changes
DATABASE_MIGRATION_URL=postgresql://db_owner:migration_password@localhost:5432/paz_animal_local

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# JWT secrets (MUST be 32+ characters in production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-this
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-long-change-this
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

# Initial admin user (for production bootstrap)
# CRITICAL: Set strong password in production!
ADMIN_DEFAULT_EMAIL=admin@pazanimal.org
ADMIN_DEFAULT_PASSWORD=Admin123!ChangeMe

# ==========================================
# OAUTH (Google Sign-In)
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ==========================================
# CLOUDFLARE R2 (Object Storage)
# ==========================================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=paz-animal-media
R2_PUBLIC_URL=https://media.pazanimal.org

# ==========================================
# MERCADO PAGO (Payment Gateway)
# ==========================================
MP_ACCESS_TOKEN=APP_USR-your-access-token
MP_PUBLIC_KEY=APP_USR-your-public-key
MP_WEBHOOK_SECRET=your-webhook-secret

# ==========================================
# REDIS (Queue & Cache)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@pazanimal.org
SMTP_PASSWORD=your-smtp-password

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=http://localhost:5173
